# Nyaya local and Render configuration. Copy to .env.local for local use. Never commit real values.
# Use the Render PostgreSQL internal connection URL for a database in the same region.
DATABASE_URL=
# Optional for a custom domain; otherwise Render supplies RENDER_EXTERNAL_URL.
# APP_ORIGIN=https://your-domain.example
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5.4-mini-2026-03-17
# Leave blank for no-key guided mode.
AI_API_KEY=
NEXT_TELEMETRY_DISABLED=1
