# Copy to .dev.vars for the local Cloudflare preview. Never commit secrets.
# OpenAI-compatible provider. Endpoint must end at /v1, not /chat/completions.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3.5-flash-lite
AI_API_KEY=
# Local Ollama alternative: http://127.0.0.1:11434/v1 with an installed model.
# An HTTPS endpoint reachable from the server is required when hosted.

# Optional, explicitly selected Gemini REST transport; default is OpenAI-compatible.
# AI_TRANSPORT=gemini-native
