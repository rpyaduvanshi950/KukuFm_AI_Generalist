{
  "name": "nyaya-legal-companion",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "npm ci --include=dev --include=optional",
    "dev": "next dev --hostname 127.0.0.1 --port 5173",
    "build": "next build --webpack",
    "start": "node --env-file-if-exists=.env.local scripts/start-render.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "node tests/legal.test.mjs && node tests/assistant.test.mjs && node tests/benchmark-v3.test.mjs && node tests/improvements.test.mjs && node tests/expanded-workflows.test.mjs && node tests/refund-evidence.test.mjs && node tests/submission.test.mjs",
    "typecheck": "tsc --noEmit",
    "benchmark:offline": "node benchmarks/run-behaviour.mjs all benchmarks/results/regression-all.json && node benchmarks/run-guards.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate-render.mjs",
    "test:render": "node tests/render-platform.test.mjs",
    "test:postgres": "node tests/postgres-budget.test.mjs",
    "test:postgres:local": "node scripts/test-postgres-local.mjs",
    "test:http": "node scripts/test-postgres-local.mjs --http",
    "benchmark:submission": "node benchmarks/submission/run.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "fflate": "^0.8.3",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.23.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "type": "module"
}
